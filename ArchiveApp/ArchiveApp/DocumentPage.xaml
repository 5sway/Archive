<Page x:Class="ArchiveApp.DocumentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ArchiveApp"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DocumentPage">

    <Grid Name="MainGrid" MouseDown="MainGrid_MouseDown" Background="White" KeyDown="MainGrid_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="DataGridTable"
              AutoGenerateColumns="False"
              HeadersVisibility="Column"
              CanUserAddRows="False"
              CanUserResizeColumns="True"
              CanUserResizeRows="False"
              CanUserSortColumns="True"
              GridLinesVisibility="All"
              BorderThickness="1"
              Margin="5,5,5,0"
              IsReadOnly="True" 
              PreviewKeyDown="DataGridTable_PreviewKeyDown"
              RowEditEnding="DataGridTable_RowEditEnding"
              MouseDoubleClick="DataGridTable_MouseDoubleClick"
              HorizontalScrollBarVisibility="Hidden">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Дата" SortMemberPath="Receipt_Date" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Receipt_Date, StringFormat=dd.MM.yyyy}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <DatePicker SelectedDate="{Binding Receipt_Date, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                    BorderThickness="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Архивный шифр" Binding="{Binding Number}" Width="*"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Annotation}" Width="*"/>
                <DataGridTextColumn Header="Источник" Binding="{Binding Source}" Width="*"/>
                <DataGridTextColumn Header="Количество копий" Binding="{Binding Copies_Count}" Width="*"/>
                <DataGridTextColumn Header="Номер полки" Binding="{Binding Shelf_Number}" Width="*"/>
                <DataGridTemplateColumn Header="Тип хранилища" Width="*" SortMemberPath="Storage_Type">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Storage_Type}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding Path=DataContext.StorageTypes, RelativeSource={RelativeSource AncestorType=Page}}"
                                  SelectedItem="{Binding Storage_Type, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <TextBox Name="DocSearchBox" Width="300" Height="20" Grid.Row="1" Margin="0,-15,220,0" VerticalAlignment="Center"
             TextAlignment="Left" VerticalContentAlignment="Center" Padding="5,0,0,0" HorizontalAlignment="Right"
             FontSize="12" TextChanged="DocSearchBox_TextChanged"/>

        <Button Name="ClearSearchBtn" Content="Очистить" Background="#bae3e8" VerticalAlignment="Center"
            HorizontalAlignment="Right" Margin="0,-15,180,0" Width="60" Height="20" Grid.Row="1" Click="ClearSearchBtn_Click"/>

        <Button Name="AddBtn" Content="Добавить" Background="#bae3e8" VerticalAlignment="Center"
            HorizontalAlignment="Left" Margin="5,0,0,0" Width="120" Height="40" Grid.Row="1" Click="AddBtn_Click"/>

        <Button Name="DelBtn" Content="Удалить" Background="#bae3e8" VerticalAlignment="Center"
            HorizontalAlignment="Left" Margin="130,0,0,0" Width="120" Height="40" Grid.Row="1" Click="DelBtn_Click"/>

        <Button Name="EditBtn" Content="Изменить" Background="#bae3e8" VerticalAlignment="Center"
            HorizontalAlignment="Right" Margin="0,0,15,0" Width="150" Height="40" Grid.Row="1" Click="EditBtn_Click"/>

        <Button Name="AttachScanBtn" Content="Прикрепить скан" Background="#bae3e8" VerticalAlignment="Center"
            HorizontalAlignment="Left" Margin="255,0,0,0" Width="120" Height="40" Grid.Row="1" Click="AttachScanBtn_Click"/>

        <Button Name="ViewScansBtn" Content="Просмотреть сканы" Background="#bae3e8" VerticalAlignment="Center"
            HorizontalAlignment="Left" Margin="380,0,0,0" Width="120" Height="40" Grid.Row="1" Click="ViewScansBtn_Click"/>
        <ComboBox x:Name="StorageTypeFilter" Width="150" Height="25" Grid.Row="1" 
          VerticalAlignment="Center" HorizontalAlignment="Left" Margin="510,0,0,0"
          SelectionChanged="StorageTypeFilter_SelectionChanged">
            <ComboBoxItem Content="Все типы" IsSelected="True"/>
            <ComboBoxItem Content="Бумажный"/>
            <ComboBoxItem Content="Электронный"/>
        </ComboBox>
    </Grid>
</Page>